<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:background="@drawable/bg_floating_ball"
    android:elevation="4dp">

    <ImageView
        android:id="@+id/ball_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_ball_waveform" />

    <!-- Status dot (idle = red), top-right like the prototype -->
    <View
        android:id="@+id/ball_status_dot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_status_dot_idle" />

</FrameLayout>
