<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScreenPal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/purple_80</item>
        <item name="android:colorPrimaryDark">@color/purple_80</item>
        <item name="android:colorAccent">@color/purple_accent_80</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <style name="Theme.ScreenPal.Overlay" parent="Theme.ScreenPal">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ScreenPal.NoActionBar" parent="Theme.ScreenPal">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
